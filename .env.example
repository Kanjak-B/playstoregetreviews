# Chemin facultatif vers la configuration JSON (variables exportées par le shell).
PLAYSTORE_CONFIG=config.example.json
# Facultatif : webhook existant, uniquement pour les nouveaux avis négatifs.
# REVIEW_WEBHOOK_URL=

# Phase 2 : saisir la clé dans les paramètres sécurisés de l'environnement.
# PLAYSTORE_LLM_API_KEY=
# OPENAI_API_KEY existante est aussi reconnue ; ne jamais enregistrer de valeur ici.

# Phases 4–5 : identifiants SMTP réels fournis au processus par un gestionnaire de secrets.
# PLAYSTORE_SMTP_USERNAME=
# PLAYSTORE_SMTP_PASSWORD=
# Cron : chemins absolus vers l'exécutable et la configuration privée.
# PLAYSTORE_BIN=/opt/playstoregetreviews/.venv/bin/playstoregetreviews
# PLAYSTORE_CONFIG=/etc/playstoregetreviews/config.json
