# Optional JSON configuration path. Export these variables in the shell.
PLAYSTORE_CONFIG=config.example.json
# Optional legacy webhook, used only for new negative reviews.
# REVIEW_WEBHOOK_URL=

# Provide the LLM key through secure environment settings, never in Git.
# PLAYSTORE_LLM_API_KEY=
# An existing OPENAI_API_KEY is also supported as a fallback.

# SMTP credentials must be available to the process, using a secret manager.
# PLAYSTORE_SMTP_USERNAME=
# PLAYSTORE_SMTP_PASSWORD=
# Cron: absolute paths to the installed executable and private configuration.
# PLAYSTORE_BIN=/opt/playstoregetreviews/.venv/bin/playstoregetreviews
# PLAYSTORE_CONFIG=/etc/playstoregetreviews/config.json
