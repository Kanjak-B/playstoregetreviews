{
  "db_path": "data/reviews.db",
  "export_dir": "exports",
  "apps": [
    {
      "package_name": "com.visa.cemea.visapay",
      "name": "Visa Pay",
      "description": "Application à suivre",
      "language": "fr",
      "country": "cd",
      "max_score": 2,
      "max_fetch": 500,
      "recipient_email": null,
      "recipient_authorized": false,
      "interval_minutes": 1440
    }
  ],
  "analysis": {
    "model": "gpt-4o-mini",
    "max_reviews_per_batch": 40,
    "max_batches_per_run": 5,
    "max_input_chars": 24000,
    "max_output_tokens": 3000,
    "timeout_seconds": 60
  },
  "report_dir": "reports",
  "email": {
    "provider": "resend",
    "enabled": false,
    "from_address": null,
    "timeout_seconds": 30,
    "max_attempts": 3,
    "max_deliveries_per_run": 10
  }
}
