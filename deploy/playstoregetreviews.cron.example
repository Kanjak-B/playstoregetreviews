# Adapt absolute paths before installing with crontab -e.
# The private file exports PLAYSTORE_BIN, PLAYSTORE_CONFIG, and credentials.
# The wrapper sets umask 077; protect the log directory with mode 700 as well.
# Check every 15 minutes; each application respects interval_minutes.
*/15 * * * * PLAYSTORE_ENV_FILE=/etc/playstoregetreviews/runtime.env /opt/playstoregetreviews/deploy/run-scheduled.sh >> /var/lib/playstoregetreviews/workflow.log 2>&1
